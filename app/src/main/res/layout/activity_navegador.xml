<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/contenedor"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#000000">

    <LinearLayout
        android:id="@+id/panel"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/barra"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:background="?attr/colorSurface"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="4dp"
            android:paddingEnd="4dp">

            <ImageButton
                android:id="@+id/btnAtras"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icono_boton"
                android:contentDescription="@string/atras"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_atras"
                app:tint="?attr/colorOnSurface" />

            <TextView
                android:id="@+id/titulo"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="?attr/colorOnSurface"
                android:textSize="16sp" />

            <ImageButton
                android:id="@+id/btnCursor"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icono_boton"
                android:contentDescription="@string/cursor"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cursor"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnPip"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icono_boton"
                android:contentDescription="@string/pip_boton"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_pip"
                android:visibility="gone"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnRecargar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icono_boton"
                android:contentDescription="@string/recargar"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_recargar"
                app:tint="?attr/colorOnSurface" />

            <ImageButton
                android:id="@+id/btnCerrar"
                android:layout_width="44dp"
                android:layout_height="44dp"
                android:background="@drawable/bg_icono_boton"
                android:contentDescription="@string/cerrar"
                android:focusable="true"
                android:padding="10dp"
                android:scaleType="fitCenter"
                android:src="@drawable/ic_cerrar"
                app:tint="?attr/colorOnSurface" />
        </LinearLayout>

        <FrameLayout
            android:id="@+id/areaWeb"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <WebView
                android:id="@+id/web"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />

            <ProgressBar
                android:id="@+id/progreso"
                style="?android:attr/progressBarStyleHorizontal"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:layout_gravity="top"
                android:max="100" />
        </FrameLayout>
    </LinearLayout>
</FrameLayout>
